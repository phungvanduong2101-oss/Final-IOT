{
  "openapi": "3.0.0",
  "info": {
    "title": "IoT API",
    "version": "1.0.0",
    "description": "Tài liệu API hệ thống giám sát và điều khiển thiết bị"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Server local"
    }
  ],
  "paths": {
    "/api/sensors-data/latest": {
      "get": {
        "summary": "Lấy 10 bản ghi mới nhất của mỗi loại cảm biến",
        "tags": [
          "Sensors"
        ],
        "responses": {
          "200": {
            "description": "Trả về ba mảng Temperature, Humidity và Light"
          },
          "500": {
            "description": "Lỗi máy chủ"
          }
        }
      }
    },
    "/api/devices/status": {
      "get": {
        "summary": "Lấy danh sách thiết bị và trạng thái hiện tại",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách thành công"
          },
          "500": {
            "description": "Lỗi máy chủ"
          }
        }
      }
    },
    "/api/devices/{id}/control": {
      "post": {
        "summary": "Gửi lệnh bật hoặc tắt thiết bị",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "ID thiết bị cần điều khiển",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "ON",
                      "OFF"
                    ]
                  }
                }
              },
              "example": {
                "action": "ON"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã gửi lệnh, đang chờ thiết bị phản hồi",
            "content": {
              "application/json": {
                "example": {
                  "code": "success"
                }
              }
            }
          },
          "400": {
            "description": "Lệnh phải là ON hoặc OFF"
          },
          "404": {
            "description": "Không tìm thấy thiết bị"
          },
          "500": {
            "description": "Lỗi máy chủ hoặc gửi lệnh MQTT thất bại"
          },
          "503": {
            "description": "MQTT chưa kết nối"
          }
        }
      }
    },
    "/api/sensors-data": {
      "get": {
        "summary": "Tìm kiếm và phân trang dữ liệu cảm biến",
        "tags": [
          "Sensors"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "description": "Từ khóa tìm kiếm",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "in": "query",
            "name": "searchBy",
            "description": "Chọn loại cảm biến hoặc tìm theo thời gian",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "Temperature",
                "Humidity",
                "Light",
                "Time"
              ],
              "default": "ALL"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Trang hiện tại",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "items",
            "description": "Số bản ghi mỗi trang",
            "schema": {
              "type": "integer",
              "enum": [
                10,
                20,
                50
              ],
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "Sắp xếp theo thời gian",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy dữ liệu thành công"
          },
          "500": {
            "description": "Lỗi máy chủ"
          }
        }
      }
    },
    "/api/actions-history": {
      "get": {
        "summary": "Tìm kiếm và phân trang lịch sử điều khiển",
        "tags": [
          "Actions"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "description": "Tìm theo tên thiết bị, lệnh, trạng thái hoặc thời gian",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "in": "query",
            "name": "device",
            "description": "Nhập ALL hoặc ID thiết bị",
            "schema": {
              "type": "string",
              "default": "ALL"
            }
          },
          {
            "in": "query",
            "name": "status",
            "description": "Lọc theo trạng thái thao tác",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "SUCCESS",
                "FAILED",
                "TIMEOUT"
              ],
              "default": "ALL"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Trang hiện tại",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "items",
            "description": "Số bản ghi mỗi trang",
            "schema": {
              "type": "integer",
              "enum": [
                10,
                20,
                50
              ],
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "sort",
            "description": "Sắp xếp theo thời gian",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy lịch sử thành công"
          },
          "500": {
            "description": "Không tải được lịch sử thao tác"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}