extends layouts/default.pug

include partials/icons.pug

block content
  .ds-page
    .ds-toolbar
      .ds-search-wrap(style="max-width:360px;")
        input#ds-search(
          type="text"
          placeholder="Search..."
          autocomplete="off"
        )
        +searchIcon()

      .ds-filter-group
        label(for="ds-search-by") Search by

        select#ds-search-by.ds-select
          option(value="ALL") ALL
          option(value="Temperature") Temperature
          option(value="Humidity") Humidity
          option(value="Light") Light
          option(value="Time") Time

      .ds-filter-group
        label(for="ds-sort") Sort

        select#ds-sort.ds-select
          option(value="DESC") Newest
          option(value="ASC") Oldest  

      .ds-filter-group
        label(for="ds-limit") Items
        select#ds-items.ds-select
          option(value="10") 10
          option(value="20") 20 
          option(value="50") 50


      button#ds-reset.ds-reset-btn(type="button") Đặt lại

    .ds-table-wrap
      table.ds-table
        thead
          tr
            th SENSOR ID
            th SENSOR
            th Type
            th Value
            th Time

        tbody#ds-table-body
          tr
            td(colspan="5") Đang tải dữ liệu...

    .ds-table-footer
      #ds-summary.ds-summary Hiển thị 0–0 trên tổng 0 bản ghi
      #ds-pagination.ds-pagination

block scripts
  script(src="/js/api.js")
  script(src="/js/table.js")
  script(src="/js/data-sensor.js")