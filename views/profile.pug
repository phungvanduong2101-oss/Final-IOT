extends layouts/default.pug

include partials/icons.pug

block styles
  link(rel="stylesheet" href="/css/profile.css")

block content
  main.profile-page
    .profile-card
      .profile-avatar-wrap
        img.profile-avatar(
          src="/assets/images/B23DCCN226.png"
          alt="Avatar của Phùng Văn Dương"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        )

        .profile-avatar-fallback(style="display:none;")
          +avatarIcon()

      h1.profile-name Phùng Văn Dương
      p.profile-id B23DCCN226

      hr.profile-divider

      ul.profile-links
        li.profile-link-item
          span.profile-link-label Github:

          a.profile-link-url(
            href="https://github.com/phungvanduong2101-oss"
            target="_blank"
            rel="noopener noreferrer"
            title="https://github.com/phungvanduong2101-oss"
          ) https://github.com/phungvan...

        li.profile-link-item
