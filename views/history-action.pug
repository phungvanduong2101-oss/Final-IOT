extends layouts/default.pug

include partials/icons.pug

block content
  .ds-page
    .ha-toolbar
      .ha-search-wrap
        input#ha-search(
          type="text"
          placeholder="Search..."
          autocomplete="off"
        )
        +searchIcon()

      .ha-filters
        .ha-filter-group
          label(for="ha-device") Device

          select#ha-device.ha-select
            option(value="ALL") ALL
            option(value="1") Quạt
            option(value="2") Đèn
            option(value="3") Điều hòa

        //.ha-filter-group
          label(for="ha-action") Action

          select#ha-action.ha-select
            option(value="ALL") ALL
            option(value="ON") ON
            option(value="OFF") OFF

        .ha-filter-group
          label(for="ha-status") Status

          select#ha-status.ha-select
            option(value="ALL") ALL
            option(value="SUCCESS") SUCCESS
            option(value="FAILED") FAILED
            option(value="WAITING") WAITING

        .ha-filter-group
          label(for="ha-sort") Sort

          select#ha-sort.ha-select
            option(value="DESC") Newest
            option(value="ASC") Oldest  

        .ha-filter-group
          label(for="ha-items") Items

          select#ha-items.ha-select
            option(value="10") 10
            option(value="20") 20
            option(value="50") 50
         
        button#ha-reset.ds-reset-btn(type="button") Đặt lại

    .ha-table-wrap
      table.ha-table
        thead
          tr
            th Device ID
            th Device Name
            th Action
            th Status
            th Time

        tbody#ha-table-body
          tr
            td(colspan="5") Đang tải dữ liệu...
    .ha-table-footer
      #ha-summary.ha-summary Hiển thị 0–0 trên tổng 0 bản ghi
      #ha-pagination.ha-pagination

block scripts
  script(src="/js/api.js")
  script(src="/js/history-action.js")